# RemesaAI — environment variables

# Anthropic Claude API key for the voice intent parser.
# Without this set, the API route falls back to a deterministic regex parser
# (works for typical phrasings, but the Claude path is the real product).
ANTHROPIC_API_KEY=

# Optional: override the USD→MXN reference rate (defaults baked in src/lib/fx.ts)
# NEXT_PUBLIC_FX_OVERRIDE=17.45
