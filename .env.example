# RemesaAI — environment variables

# Mistral API key for the voice intent parser.
# Get one at https://console.mistral.ai/api-keys
# Without this set, /api/agent falls back to a deterministic regex parser
# (works for typical phrasings, but the LLM path is the real product).
MISTRAL_API_KEY=

# Optional: override the Mistral model (defaults to mistral-large-latest)
# MISTRAL_MODEL=mistral-large-latest

# Optional: override the USD→MXN reference rate (defaults baked in src/lib/fx.ts)
# NEXT_PUBLIC_FX_OVERRIDE=17.45
